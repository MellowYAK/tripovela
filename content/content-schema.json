            },
            {
              "type": "null"
            }
          ]
        },
        "day_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "order": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "place_id",
        "experience_id",
        "day_number",
        "order"
      ],
      "additionalProperties": false
