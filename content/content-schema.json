{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tripovela/content-package/1.0.0/schema.json",
  "title": "PROPOSED Tripovela Content Package v1.0.0 — not the existing site format",
  "description": "Proposed manual model-agnostic editorial patch contract. Validate with a draft-2020-12 validator plus semantic checks. Never imports API prices or publishes automatically.",
  "type": "object",
  "properties": {
    "manifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "mode": {
          "const": "patch"
        },
        "purpose": {
          "enum": [
            "demo",
            "editorial_transfer"
          ]
        },
        "export_id": {
          "type": "string",
          "format": "uuid"
        },
        "base_revision": {
          "type": "string",
          "minLength": 1
        },
        "exported_at": {
          "type": "string",
          "format": "date-time"
        },
        "site_key": {
          "type": "string",
          "minLength": 1
        },
        "default_locale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "locales": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          },
          "uniqueItems": true
        },
        "apply_policy": {
          "const": "stage_drafts_only"
        },
        "omitted_policy": {
          "const": "preserve"
        }
      },
      "required": [
        "schema_version",
        "mode",
        "purpose",
        "export_id",
        "base_revision",
        "exported_at",
        "site_key",
        "default_locale",
        "locales",
        "apply_policy",
        "omitted_policy"
      ],
      "additionalProperties": false,
      "readOnly": true
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      },
      "uniqueItems": true
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/category_record"
          },
          {
            "$ref": "#/$defs/destination_record"
          },
          {
            "$ref": "#/$defs/place_record"
          },
          {
            "$ref": "#/$defs/experience_record"
          },
          {
            "$ref": "#/$defs/article_record"
          }
        ]
      }
    }
  },
  "required": [
    "manifest",
    "assets",
    "records"
  ],
  "additionalProperties": false,
  "$defs": {
    "translation": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "body_markdown": {
          "type": "string"
        },
        "seo_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "seo_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "slug": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "image_alt": {
          "type": "string"
        },
        "translation_status": {
          "enum": [
            "draft",
            "human_review_required",
            "review_ready"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,95}$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "checked_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "verification_state": {
          "enum": [
            "unverified",
            "reviewed"
          ]
        },
        "supports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_id",
        "url",
        "publisher",
        "checked_at",
        "verification_state",
        "supports"
      ],
      "additionalProperties": false
    },
    "media_ref": {
      "type": "object",
      "properties": {
