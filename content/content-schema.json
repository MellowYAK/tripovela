      "required": [
        "asset_id",
        "role"
      ],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,95}$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "media_type": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/avif"
          ]
        },
        "credit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "license_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            {
              "type": "null"
            }
          ]
        },
        "rights_state": {
          "enum": [
            "unverified",
            "approved_by_editor"
          ]
        }
      },
      "required": [
        "asset_id",
        "url",
        "media_type",
        "credit",
        "license_url",
        "source_url",
        "rights_state"
      ],
      "additionalProperties": false,
      "readOnly": true
    },
    "provider_binding": {
      "type": "object",
      "properties": {
        "offer_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,95}$"
        },
        "provider": {
          "const": "viator"
        },
        "product_code": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "offer_ref",
        "provider",
        "product_code"
      ],
      "additionalProperties": false,
      "readOnly": true
    },
    "context": {
      "type": "object",
      "properties": {
        "provider_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provider_binding"
          },
          "uniqueItems": true
        },
        "provider_owned_fields": {
          "type": "array",
          "items": {
            "enum": [
              "price",
              "currency",
              "availability",
              "rating",
              "review_count",
              "supplier_title",
              "supplier_description",
              "supplier_images",
              "duration",
              "cancellation_policy",
              "booking_url"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [],
      "additionalProperties": false,
      "readOnly": true,
      "description": "Immutable export context. This does not contain provider payloads. Importer compares with the stored export and never applies edits here."
    },
    "visit_cost": {
      "type": "object",
      "properties": {
        "classification": {
          "enum": [
            "unknown",
            "free",
            "paid",
            "mixed"
          ]
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{2,95}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "verified_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "classification",
        "source_id",
        "verified_at"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {
                "enum": [
                  "free",
                  "paid",
                  "mixed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{2,95}$"
              },
              "verified_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ],
      "description": "Editorial admission classification only, never a numeric price. Non-unknown classifications require a reviewed source checked by the importer/editor."
    },
