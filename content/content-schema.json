          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,95}$"
        },
        "role": {
          "enum": [
            "cover",
            "inline",
            "gallery"
          ]
        },
        "alt": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          },
          "additionalProperties": {
